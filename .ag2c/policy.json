{
  "cards": [
    {
      "id": "constitution.project",
      "references": [
        "AGENTS.md",
        "CLAUDE.md"
      ],
      "summary": "All changes use AG2C routing, isolated worktrees, verified checks, and evidence-backed integration.",
      "title": "Managed project invariants",
      "type": "constitution"
    },
    {
      "checkers": [
        "check.diff",
        "check.python"
      ],
      "id": "floor.root",
      "references": [
        "AGENTS.md",
        "CLAUDE.md"
      ],
      "scopes": [
        {
          "include": [
            ".gitattributes",
            "CHANGELOG.md",
            "CONTRIBUTING.md",
            "LICENSE",
            "MANIFEST.in",
            "README.md",
            "README.zh-CN.md",
            "SECURITY.md",
            "pyproject.toml"
          ],
          "ownership": "primary",
          "target": "app"
        }
      ],
      "summary": "Conservative ownership for tracked files at the project root.",
      "title": "Project root files",
      "type": "floor"
    },
    {
      "checkers": [
        "check.diff",
        "check.python"
      ],
      "id": "floor.github",
      "references": [
        "AGENTS.md",
        "CLAUDE.md"
      ],
      "scopes": [
        {
          "include": [
            ".github/**"
