          "target": "app"
        }
      ],
      "summary": "Conservative ownership for the detected top-level docs project area.",
      "title": "docs area",
      "type": "floor"
    },
    {
      "checkers": [
        "check.diff",
        "check.python"
      ],
      "id": "floor.examples",
      "references": [
        "AGENTS.md",
        "CLAUDE.md"
      ],
      "scopes": [
        {
          "include": [
            "examples/**"
          ],
          "ownership": "primary",
          "target": "app"
