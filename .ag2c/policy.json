  "checkers": [
    {
      "command": [
        "git",
        "diff",
        "--check"
      ],
      "cwd": ".",
      "id": "check.diff",
      "stage": "floor",
      "target": "app",
      "timeout": 60
    },
    {
      "command": [
        "python",
        "-B",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests"
      ],
      "cwd": ".",
      "id": "check.python",
      "stage": "floor",
      "target": "app",
      "timeout": 900
    }
  ],
