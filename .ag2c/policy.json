    },
    {
      "checkers": [
        "check.diff",
        "check.python"
      ],
      "id": "floor.tests",
      "references": [
        "AGENTS.md",
        "CLAUDE.md"
      ],
      "scopes": [
        {
          "include": [
            "tests/**"
